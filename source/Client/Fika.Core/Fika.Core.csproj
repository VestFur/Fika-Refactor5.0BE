<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Build.props" />
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release;GoldMaster</Configurations>
    <DefineConstants>$(DefineConstants);FIKA_IL2CPP</DefineConstants>
    <!-- Keep build-machine paths out of the shipped symbols: stack traces then
         read "Fika.Core/Main/GameMode/CoopGame.cs:646" instead of exposing the
         absolute path of whichever checkout produced the assembly. -->
    <PathMap>$(MSBuildProjectDirectory)=Fika.Core</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'GoldMaster'">
    <DefineConstants>$(DefineConstants);GOLDMASTER</DefineConstants>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bundles\Files\masterbundle.il2cpp.bundle" LogicalName="Fika.Core.Bundles.Files.masterbundle.bundle" />
    <None Remove="Bundles\Files\masterbundle.bundle" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Mono.Cecil.dll" Private="false" />
    <Reference Include="$(BepInExCore)\MonoMod.Utils.dll" Private="false" />
    <Reference Include="$(BepInExCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(SptClientDir)\*.dll" Private="false" />
    <Reference Include="$(SptClientDir)\ConfigurationManager\BepInEx.KeyboardShortcut.dll" Private="false" />
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')" Text="SPT 5.0 IL2CPP interop assemblies missing. Pass -p:GameDir=path-to-game." />
  </Target>
</Project>
